{
  "name": "spooky-ts",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run dev -w @spooky/web",
    "dev": "npm run dev -w @spooky/web",
    "build": "npm run build -w @spooky/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
